# ============================================================
# VocabQuest environment variables (template)
# Copy to .env.local and adjust. Do NOT commit real secrets.
# ============================================================

# ---- Supabase connection (optional) ----
# When empty, the app falls back to the built-in demo project.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---- Local one-click login (本地一键登录) ----
# Whether the local login button appears on the auth page.
# Default: enabled. Set to "false" to hide the button.
VITE_LOCAL_LOGIN_ENABLED=true

# Account used when clicking the local login button - no password typing
# needed at runtime, the values below are read from this file instead.
VITE_LOCAL_LOGIN_EMAIL=demo@vocabquest.local
VITE_LOCAL_LOGIN_PASSWORD=demo123456

# Profile used when the local login user is created on the fly
# (only possible when the Supabase project has email confirmation disabled).
VITE_LOCAL_LOGIN_FULL_NAME=Demo Student
VITE_LOCAL_LOGIN_ROLE=student
VITE_LOCAL_LOGIN_GRADE_LEVEL=4
